<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Used only while a running or cycling session is open, to measure speed. No
         coordinate is stored, and a refusal falls back to an assumed effort.
         Coarse is declared alongside fine because Android 12 and later offer the user a
         Precise/Approximate choice: asking for fine alone leaves the approximate answer
         granting nothing, so a user who picks it gets neither speed nor an explanation.
         Speed still needs fine, so approximate falls back to the assumed effort. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Install-time, no prompt. Lets the exercise session keep reading GPS with the screen
         off, and only while a session's notification is showing. The runtime location
         permission is still asked only when a running or cycling session starts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Held only while an exercise session runs, so its clock and jump count continue with
         the screen off. Install-time, no prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Declared but not required, so the listing stays downloadable on every device. The
         app checks for the sensor at launch instead, and says plainly why it cannot run
         when there is none. Filtering at the store would hide it from phones whose sensor
         the store's own data gets wrong. -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <!-- The app works without it; a session simply falls back to an assumed effort. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".BodyFitApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BodyFit">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BodyFit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sensor.StepTrackerService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <service
            android:name=".sensor.ExerciseSessionService"
            android:exported="false"
            android:foregroundServiceType="location|health|shortService" />

        <receiver
            android:name=".notification.WaterActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".sensor.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
