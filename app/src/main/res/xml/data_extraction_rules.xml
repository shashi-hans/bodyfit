<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later ignore allowBackup="false" for device-to-device transfer, so a new
     phone set up from an old one would copy the health history across without the user
     choosing to. Everything is excluded from both paths; the backup file is the one way
     history moves, and the user decides where it goes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
